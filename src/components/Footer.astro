---
import { company } from "../data/company";
const year = new Date().getFullYear();
---

<footer class="bg-[#faf8f6] px-4 pb-10 text-[#17121a] sm:px-6 lg:px-8">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8 border-t border-[#17121a]/10 pt-10 sm:flex-row sm:items-center sm:justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/imgs/logoNovusTech.png" width="40" height="40" alt="" class="h-10 w-10 rounded-full object-cover" />
      <span>
        <span class="block text-lg font-bold leading-tight text-[#6f0a59]" style="font-family: 'Times New Roman', Times, serif">NovusTech</span>
        <span class="block text-[11px] uppercase tracking-[0.14em] text-[#8f8894]">Tecnologia para autoescolas</span>
      </span>
    </a>

    <nav aria-label="Navegação do rodapé" class="flex flex-wrap gap-x-7 gap-y-3 text-sm text-[#6b6470]">
      <a href="/autoescolas" class="transition hover:text-[#6f0a59]">Autoescolas</a>
      <a href="/instrutores-autonomos" class="transition hover:text-[#6f0a59]">Instrutores autônomos</a>
      <a href="/minhas-aulas" class="transition hover:text-[#6f0a59]">Minhas aulas</a>
      <a href="/guias" class="transition hover:text-[#6f0a59]">Guias</a>
    </nav>

    <a href={company.phoneHref} class="inline-flex items-center gap-2 text-sm font-semibold text-[#6f0a59] transition hover:text-[#17121a]">
      {company.phone}
    </a>
  </div>

  <div class="mx-auto mt-8 flex max-w-[1200px] flex-col gap-2 text-xs text-[#8f8894] sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {company.name} · CNPJ {company.cnpj} · Novus CFC para autoescolas.</p>
    <a href="https://thenovustech.com.br/" class="transition hover:text-[#6f0a59]">thenovustech.com.br</a>
  </div>
</footer>
