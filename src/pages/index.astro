---
import "../styles/global.css";
import "../styles/landing.css";
import Layout from "../layouts/Layout.astro";
import NovusCFCLanding from "../components/NovusCFCLanding.astro";

const title = "Sistema para Autoescola | Agenda e Gestão de CFC – Novus CFC";
const description = "Novus CFC é o sistema de gestão para autoescolas: agenda de aulas, alunos, instrutores e veículos em um só lugar. Alunos pedem aula pelo celular.";
---

<Layout title={title} description={description} canonicalPath="/">
	<NovusCFCLanding />
</Layout>
